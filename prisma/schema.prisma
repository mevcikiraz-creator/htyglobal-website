generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
enum PublishStatus {
 DRAFT
 PUBLISHED
}
model User {
 id String @id @default(cuid())
 email String @unique
 name String
 passwordHash String
 role String @default("EDITOR")
 active Boolean @default(true)
 tokenVersion Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model ProductCategory {
 id String @id @default(cuid())
 slug String @unique
 title String
 description String @default("")
 status PublishStatus @default(DRAFT)
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json @default("{}")
 translations Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 products Product[]
 @@index([status,sortOrder])
}
model ProjectCategory {
 id String @id @default(cuid())
 slug String @unique
 title String
 description String @default("")
 status PublishStatus @default(DRAFT)
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json @default("{}")
 translations Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 projects Project[]
 @@index([status,sortOrder])
}
model Sector {
 id String @id @default(cuid())
 slug String @unique
 title String
 description String @default("")
 status PublishStatus @default(DRAFT)
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json @default("{}")
 translations Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 products Product[]
 projects Project[]
 @@index([status,sortOrder])
}
model Page {
 id String @id @default(cuid())
 slug String @unique
 title String
 description String @default("")
 status PublishStatus @default(DRAFT)
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json @default("{}")
 translations Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([status,sortOrder])
}
model Client {
 id String @id @default(cuid())
 slug String @unique
 title String
 description String @default("")
 status PublishStatus @default(DRAFT)
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json @default("{}")
 translations Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([status,sortOrder])
}
model BlogPost {
 id String @id @default(cuid())
 slug String @unique
 title String
 description String @default("")
 status PublishStatus @default(DRAFT)
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json @default("{}")
 translations Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([status,sortOrder])
}
model SiteSetting {
 id String @id @default(cuid())
 slug String @unique
 title String
 description String @default("")
 status PublishStatus @default(DRAFT)
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json @default("{}")
 translations Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([status,sortOrder])
}
model Product {
 id String @id @default(cuid())
 slug String @unique
 title String
 description String @default("")
 status PublishStatus @default(DRAFT)
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json @default("{}")
 translations Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 categoryId String?
 category ProductCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
 sectorId String?
 sector Sector? @relation(fields:[sectorId],references:[id],onDelete:SetNull)
 images ProductImage[]
 @@index([status,sortOrder])
}
model Project {
 id String @id @default(cuid())
 slug String @unique
 title String
 description String @default("")
 status PublishStatus @default(DRAFT)
 featured Boolean @default(false)
 sortOrder Int @default(0)
 data Json @default("{}")
 translations Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 categoryId String?
 category ProjectCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
 sectorId String?
 sector Sector? @relation(fields:[sectorId],references:[id],onDelete:SetNull)
 images ProjectImage[]
 @@index([status,sortOrder])
}
model ProductImage {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
 mediaId String
 media Media @relation(fields:[mediaId],references:[id],onDelete:Restrict)
 alt String
 sortOrder Int @default(0)
 @@index([productId,sortOrder])
}
model ProjectImage {
 id String @id @default(cuid())
 projectId String
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 mediaId String
 media Media @relation(fields:[mediaId],references:[id],onDelete:Restrict)
 alt String
 sortOrder Int @default(0)
 @@index([projectId,sortOrder])
}
model Media {
 id String @id @default(cuid())
 filename String
 mimeType String
 size Int
 storageKey String @unique
 alt String @default("")
 private Boolean @default(false)
 productImages ProductImage[]
 projectImages ProjectImage[]
 createdAt DateTime @default(now())
}
model ContactSubmission {
 id String @id @default(cuid())
 name String
 company String @default("")
 email String
 phone String @default("")
 country String @default("")
 subject String @default("")
 message String
 status String @default("NEW")
 data Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
}
model QuoteRequest {
 id String @id @default(cuid())
 name String
 company String @default("")
 email String
 phone String @default("")
 country String @default("")
 subject String @default("")
 message String
 status String @default("NEW")
 data Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
}
model RateLimit {
 key String @id
 hits Int
 expiresAt DateTime
 @@index([expiresAt])
}
